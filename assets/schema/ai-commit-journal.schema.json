{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommitSmith AI Commit Journal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "current": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["message"]
          }
        ]
      }
    },
    "meta": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "properties": {
        "ticketFromBranch": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "ticket": {
          "type": "string"
        }
      }
    }
  },
  "required": ["current"]
}
