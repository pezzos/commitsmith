{
  "name": "commit-smith",
  "displayName": "CommitSmith",
  "description": "Forge high-quality commits with Codex-assisted workflows.",
  "version": "0.0.63",
  "publisher": "epicsmith",
  "license": "MIT",
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/pezzos/commitsmith.git"
  },
  "scripts": {
    "compile": "tsc -p .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "npm run compile && node ./scripts/test-unit-placeholder.mjs && node ./scripts/test-vscode-shim.mjs",
    "test:config": "npm run compile && node ./scripts/test-config.mjs",
    "test:git": "node ./scripts/test-git.mjs",
    "test:codex": "node -r ts-node/register ./scripts/test-codex.ts",
    "test:codex-contract": "npm run compile && node -r ts-node/register ./scripts/test-codex-contract.ts",
    "test:journal": "npm run compile && node ./scripts/test-journal.mjs",
    "test:pipeline": "npm run compile && node ./scripts/test-pipeline.mjs",
    "test:integration": "npm run compile && node ./scripts/test-integration.mjs",
    "test:dry-run": "npm run compile && node ./scripts/test-dry-run.mjs",
    "test:offline": "npm run compile && node ./scripts/test-offline.mjs",
    "test:all": "npm run test:unit && npm run test:config && npm run test:git && npm run test:codex && npm run test:codex-contract && npm run test:journal && npm run test:pipeline && npm run test:integration && npm run test:dry-run && npm run test:offline",
    "format:check": "prettier --check . --config .prettierrc.json",
    "format:fix": "prettier --write . --config .prettierrc.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "package": "npm version patch --no-git-tag-version && npm run compile && vsce package"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "bin": {
    "commit-smith": "./bin/commit-smith.js"
  },
  "contributes": {
    "configuration": [
      {
        "title": "CommitSmith › Pipeline Steps",
        "properties": {
          "commitSmith.format.command": {
            "type": "string",
            "default": "npm run format:fix",
            "description": "Command used to format source files before committing.",
            "order": 10
          },
          "commitSmith.format.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the format command step in the automated pipeline.",
            "order": 11
          },
          "commitSmith.typecheck.command": {
            "type": "string",
            "default": "npm run typecheck",
            "description": "Command executed for type-checking.",
            "order": 20
          },
          "commitSmith.typecheck.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the typecheck command step in the automated pipeline.",
            "order": 21
          },
          "commitSmith.tests.command": {
            "type": "string",
            "default": "npm test -- -w",
            "description": "Command that runs the project test suite.",
            "order": 30
          },
          "commitSmith.tests.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the tests command step in the automated pipeline.",
            "order": 31
          }
        }
      },
      {
        "title": "CommitSmith › Pipeline Settings",
        "properties": {
          "commitSmith.pipeline.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable the automated pre-commit pipeline."
          },
          "commitSmith.pipeline.requireChecks": {
            "type": "boolean",
            "default": false,
            "description": "Run formatter/typecheck/test stages by default (guarded lane)."
          },
          "commitSmith.pipeline.maxAiFixAttempts": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "Maximum number of Codex fix attempts per pipeline step."
          },
          "commitSmith.pipeline.abortOnFailure": {
            "type": "boolean",
            "default": true,
            "description": "Abort the pipeline when a step remains failing after AI fixes."
          }
        }
      },
      {
        "title": "CommitSmith › Output",
        "properties": {
          "commitSmith.output.showDebug": {
            "type": "boolean",
            "default": false,
            "description": "Show verbose debugging messages in the CommitSmith output channel.",
            "order": 10
          }
        }
      },
      {
        "title": "CommitSmith › Commit Workflow",
        "properties": {
          "commitSmith.commit.pushAfter": {
            "type": "boolean",
            "default": false,
            "description": "Automatically push changes after a successful commit."
          },
          "commitSmith.message.style": {
            "type": "string",
            "enum": [
              "conventional",
              "plain"
            ],
            "default": "conventional",
            "description": "Commit message style generated by Codex."
          },
          "commitSmith.message.enforce72": {
            "type": "boolean",
            "default": true,
            "description": "Ensure commit subject lines stay within 72 characters."
          },
          "commitSmith.jira.fromBranch": {
            "type": "boolean",
            "default": true,
            "description": "Derive ticket identifiers from the current branch name."
          }
        }
      },
      {
        "title": "CommitSmith › Codex",
        "properties": {
          "commitSmith.codex.model": {
            "type": "string",
            "enum": [
              "gpt-5",
              "gpt-5-codex"
            ],
            "default": "gpt-5-codex",
            "description": "Codex model identifier used for commit writing."
          },
          "commitSmith.codex.reasoningLevel": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "low",
            "description": "Reasoning level passed to the Codex CLI."
          },
          "commitSmith.codex.timeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 1000,
            "description": "Maximum time in milliseconds to wait for Codex CLI responses."
          },
          "commitSmith.codex.serenaTimeoutMs": {
            "type": "number",
            "default": 180000,
            "minimum": 1000,
            "description": "Codex CLI timeout in milliseconds when CommitSmith detects a Serena automation environment."
          },
          "commitSmith.codex.binaryPath": {
            "type": "string",
            "default": "",
            "description": "Optional absolute path to the Codex CLI binary. Falls back to CODEX_PATH or the system PATH."
          },
          "commitSmith.codex.mcpWhitelist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Names of MCP servers CommitSmith should keep enabled. Any configured servers not on this list are disabled for Codex runs."
          },
          "commitSmith.codex.extraArgs": {
            "type": "string",
            "default": "",
            "description": "Additional space-separated flags appended to Codex CLI invocations (e.g. \"--profile staging\")."
          },
          "commitSmith.codex.serenaOverride": {
            "type": "string",
            "default": "",
            "description": "Optional MCP override passed as -c mcp_servers.serena=… when invoking the Codex CLI (e.g. '{command=\"/path/to/serena\",optional=true}').",
            "order": 90
          }
        }
      }
    ],
    "commands": [
      {
        "command": "commitSmith.generateFromJournal",
        "title": "CommitSmith: AI Commit (Journal)",
        "shortTitle": "⚒️",
        "icon": "$(tools)",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.clearJournal",
        "title": "CommitSmith: Clear Journal",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.installHooks",
        "title": "CommitSmith: Install Hooks",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.dryRun",
        "title": "CommitSmith: Dry Run (Coming Soon)",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.initializeRepo",
        "title": "CommitSmith: Initialize CommitSmith",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.codexBootstrap",
        "title": "CommitSmith: Run Codex Onboarding",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.chooseLane",
        "title": "CommitSmith: Choose Pipeline Lane",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.toggleLane",
        "title": "CommitSmith: Toggle Pipeline Lane",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.runFormat",
        "title": "CommitSmith: Run Formatter Check",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.runTypecheck",
        "title": "CommitSmith: Run Typecheck Check",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.runTests",
        "title": "CommitSmith: Run Test Check",
        "category": "CommitSmith"
      },
      {
        "command": "commitSmith.pipeline.showChecks",
        "title": "CommitSmith: Show Check Status",
        "category": "CommitSmith"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitSmith.generateFromJournal",
          "group": "navigation@1",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "minimatch": "^9.0.3",
    "yaml": "^2.4.1"
  }
}
